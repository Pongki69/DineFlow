{
  "name": "dineflow-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "lint": "eslint src scripts e2e *.js",
    "test:e2e": "playwright test",
    "check:design": "tsc --project tsconfig.design-lab.json && node scripts/check-design-tokens.mjs --check",
    "test:design": "vitest run src/design-lab/components.test.jsx src/design-lab/model.test.js",
    "test:design:e2e": "playwright test --config=playwright.design-lab.config.js",
    "test:production": "playwright test --config=playwright.production.config.js",
    "format": "prettier --write src scripts e2e *.js",
    "format:check": "prettier --check src scripts e2e playwright.config.js eslint.config.js"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "laravel-echo": "^2.6.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "pusher-js": "^8.6.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.0.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.7.0",
    "vite": "^8.3.0",
    "vitest": "^4.0.0"
  }
}
