VITE_API_BASE_URL=http://localhost:8081/api/v1
# Live connection details normally come from the backend's /realtime/config.
# Optional deployment overrides (public connection values only; never add a secret):
# VITE_REVERB_APP_KEY=
# VITE_REVERB_HOST=
# VITE_REVERB_PORT=8080
# VITE_REVERB_SCHEME=http
# Optional Google Maps + Places search for the admin restaurant pin picker.
# Enable Maps JavaScript API, Places API (New), and Geocoding API.
VITE_GOOGLE_MAPS_BROWSER_KEY=
# Use your Google map ID in production; development defaults to DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=
