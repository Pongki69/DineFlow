# Copy into the relevant app environment file. Never put real secrets in this template.

# Laravel application
APP_NAME=DineFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
SESSION_DOMAIN=localhost

# PostgreSQL
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=dineflow
DB_USERNAME=dineflow
DB_PASSWORD=

# Queue, cache, broadcasting, and mail (select/configure drivers per environment)
QUEUE_CONNECTION=sync
CACHE_STORE=file
BROADCAST_CONNECTION=log
MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.invalid
MAIL_FROM_NAME="${APP_NAME}"

# Object storage; use local storage in development and a private bucket policy in production
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=

# Payment provider: choose PayMongo or Xendit; keep all secret keys server-side.
PAYMENT_PROVIDER=
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# Mapping provider: Geoapify Free for the portfolio; Mapbox remains optional.
MAP_PROVIDER=geoapify
GEOAPIFY_API_KEY=
GOOGLE_MAPS_SERVER_KEY=
VITE_GOOGLE_MAPS_BROWSER_KEY=
MAPBOX_SERVER_TOKEN=
VITE_MAPBOX_PUBLIC_TOKEN=

# Realtime broadcaster / websocket server
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Location retention in days; finalize policy before enabling live rider tracking.
DELIVERY_LOCATION_RETENTION_DAYS=7
NOTIFICATION_RETENTION_DAYS=180

# Server-side routing and geocoding. No browser API key is required for OpenStreetMap tiles.
MAPBOX_SERVER_TOKEN=
MAPS_COUNTRY=ph
MAPS_ROUTING_URL=https://api.mapbox.com/directions/v5/mapbox/driving

# Local restaurant business hours timezone
RESTAURANT_TIMEZONE=Asia/Manila

RESTAURANT_TIMEZONE=Asia/Manila

# Browser-safe Reverb settings are public; keep REVERB_APP_SECRET server-side only.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
REVERB_ALLOWED_ORIGINS=localhost,127.0.0.1

# PayMongo test-mode hosted checkout and webhook signing secret
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:5173

